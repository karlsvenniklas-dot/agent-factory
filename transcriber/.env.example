# Database
POSTGRES_DB=transcriber
POSTGRES_USER=transcriber
POSTGRES_PASSWORD=transcriber
DATABASE_URL=postgresql://transcriber:transcriber@localhost:5432/transcriber

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
UPLOAD_DIR=./uploads
MODEL_DIR=./models

# Whisper (whisper.cpp)
WHISPER_MODEL=large-v3          # or medium, large-v2
WHISPER_BINARY=./bin/whisper-cli
KB_LAB_MODEL=./models/kb-whisper-large.bin   # Swedish fine-tuned model

# Pyannote (speaker diarization)
# Download from: https://huggingface.co/pyannote/speaker-diarization-3.1
PYANNOTE_MODEL_DIR=./models/pyannote

# SpeechBrain (voice embeddings)
SPEECHBRAIN_MODEL=speechbrain/spkrec-ecapa-voxceleb

# LLM for intro analysis
LLM_BACKEND=ollama              # ollama | openrouter | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# App
SECRET_KEY=change-me-in-production
ENCRYPTION_SALT=change-me-too
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
