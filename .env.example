# Lightings — optional configuration. Copy to .env and fill in what you want.
# Everything here is OPTIONAL: with no .env the app runs fine (live feed + sim,
# earthquakes, radar, aurora). These keys only unlock the extra layers below.

# Lightning source: auto (default) | live | sim
# auto = live Blitzortung feed, falling back to the simulator if it stays silent.
BLITZ_MODE=auto

# Ports (defaults shown). Frontend dev server runs on 5188 (see vite.config.js).
PORT=8088

# 🔥 Fires layer (NASA FIRMS active-fire detections). Get a free key at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# 🤖 Storm Desk + 🔮 Ask the Planet (Claude via OpenRouter). Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
