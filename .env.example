# Skapa en Spotify-app på https://developer.spotify.com/dashboard
# Lägg till "http://localhost:3000/api/auth/callback" som Redirect URI.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

# URL till PartyKit-servern. När du kör `partykit dev` blir det http://127.0.0.1:1999
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Standard-spellistan som används om värden inte klistrar in en egen URL.
NEXT_PUBLIC_DEFAULT_PLAYLIST_ID=1x6HoQHp7B6jUIqA3zSzgC
