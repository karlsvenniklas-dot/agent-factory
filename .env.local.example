# Supabase - hitta dessa i Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role - används bara server-side (admin-operationer, bypassa RLS)
# ALDRIG exponera denna till klienten
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL - används för magic link callbacks
# Lokalt: http://localhost:3000
# Produktion: https://din-domän.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
